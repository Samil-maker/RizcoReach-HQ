{
  "manifest_version": 3,
  "name": "RizcoReach Lead Hunter",
  "short_name": "Lead Hunter",
  "version": "1.0.0",
  "description": "Find businesses running Meta ads, audit the websites their ads send people to, and pitch them with a personalised message.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Lead Hunter",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "unlimitedStorage", "tabs", "alarms", "notifications"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["https://*.facebook.com/ads/library*"],
      "js": ["content/hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.facebook.com/ads/library*"],
      "js": ["lib/common.js", "lib/extract-ads.js", "content/adlib.js"],
      "run_at": "document_start"
    }
  ]
}
