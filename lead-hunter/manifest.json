{
  "manifest_version": 3,
  "name": "RizcoReach Lead Hunter",
  "short_name": "Lead Hunter",
  "version": "2.1.0",
  "description": "Find UAE businesses and people asking for help online, check and score them, and export them to Google Contacts.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Lead Hunter",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "unlimitedStorage", "tabs", "alarms", "notifications"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["https://*.facebook.com/ads/library*"],
      "js": ["content/hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://*.facebook.com/ads/library*"],
      "js": ["lib/common.js", "lib/extract-ads.js", "content/adlib.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.google.com/maps*", "https://www.google.ae/maps*"],
      "js": ["content/maps-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.google.com/maps*", "https://www.google.ae/maps*"],
      "js": ["lib/common.js", "content/maps.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content/instagram.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.facebook.com/*", "https://web.facebook.com/*", "https://www.linkedin.com/*"],
      "exclude_matches": ["https://*.facebook.com/ads/library*"],
      "js": ["content/social-scan.js"],
      "run_at": "document_idle"
    }
  ]
}
