# RizcoReach cold email settings
#
# 1. Copy this file and name the copy .env  (in Terminal: cp .env.example .env)
# 2. Fill in the values below. Never share .env and never commit it (it is in .gitignore).
# 3. Run:  python run.py check

# ---------------------------------------------------------------- You
# The name people see in their inbox and the name you sign off with
FROM_NAME=Samil
# Your WhatsApp number, printed under your name in every email. Digits are fine, for example +971501234567
WHATSAPP_NUMBER=
# The folder of example sites you send to people who say yes (only used in reply drafts, never in cold emails)
EXAMPLES_LINK=https://drive.google.com/drive/folders/1n7bsLjcPoeZJls_nX_HKGQHmSDcseagz
# Where "python run.py test-email" sends the one test email. Use a different address you own
# (your everyday Gmail, for example), so you can see whether it lands in Inbox or Spam.
TEST_EMAIL_TO=
# Save drafted replies to interested people in your mailbox's Drafts folder (yes or no).
# They are never sent for you: you open Drafts, read, edit and press Send yourself.
SAVE_DRAFTS=yes
# Emails a day per inbox, follow ups included (1 to 100). Also on the dashboard under Controls.
DAILY_LIMIT=50
# Prices in AED used in the emails (also on the dashboard under Controls)
WEBSITE_PRICE=749
CARE_PLAN_PRICE=480

# ---------------------------------------------------------------- Sending inbox 1
INBOX1_EMAIL=samilatrizcoreach@gmail.com
# gmail      = a free @gmail.com address (needs an App Password)
# workspace  = Google Workspace on your own domain (needs an App Password)
# zoho       = Zoho Mail on your own domain, paid plan (smtppro.zoho.com). Use zoho-eu or zoho-in
#              if your Zoho login address ends in .eu or .in
# custom     = anything else: also fill in the four SMTP/IMAP lines below
INBOX1_PROVIDER=gmail
# The App Password (16 letters) for this inbox, NOT your normal password. See README step 3.
INBOX1_APP_PASSWORD=
# Optional: only if your provider needs a login name that is not the email address
INBOX1_USERNAME=
# Optional: only for provider=custom, or to override the defaults
INBOX1_SMTP_HOST=
INBOX1_SMTP_PORT=
INBOX1_IMAP_HOST=
INBOX1_IMAP_PORT=
# Optional: a lower daily limit for this inbox only
INBOX1_DAILY_CAP=
# Which emails this inbox sends: website, ads (Meta ads) or both
INBOX1_CAMPAIGN=website
# Optional: your DKIM selector if you use your own domain and the check cannot find it (for example zmail or google)
INBOX1_DKIM_SELECTOR=

# ---------------------------------------------------------------- Sending inbox 2 (optional)
# More emails a day: add another inbox (easiest from the dashboard: Add an inbox).
# Leads are shared between the inboxes that send their campaign.
INBOX2_EMAIL=
INBOX2_PROVIDER=
INBOX2_APP_PASSWORD=
