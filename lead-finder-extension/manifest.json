{
  "manifest_version": 3,
  "name": "RizcoReach Lead Finder",
  "version": "1.0.0",
  "description": "Collect businesses with no website and their mobile numbers from Google Maps. Save them to Google Contacts or Sheets and message them on WhatsApp.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Open Lead Finder",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["sidePanel", "storage", "unlimitedStorage", "scripting"],
  "host_permissions": [
    "https://www.google.com/maps*",
    "https://www.google.ae/maps*",
    "https://www.google.com.sa/maps*",
    "https://www.google.com.qa/maps*",
    "https://www.google.com.kw/maps*",
    "https://www.google.com.bh/maps*",
    "https://www.google.com.om/maps*",
    "https://www.google.co.uk/maps*",
    "https://www.google.co.in/maps*",
    "https://www.google.com.pk/maps*",
    "https://maps.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/maps*",
        "https://www.google.ae/maps*",
        "https://www.google.com.sa/maps*",
        "https://www.google.com.qa/maps*",
        "https://www.google.com.kw/maps*",
        "https://www.google.com.bh/maps*",
        "https://www.google.com.om/maps*",
        "https://www.google.co.uk/maps*",
        "https://www.google.co.in/maps*",
        "https://www.google.com.pk/maps*",
        "https://maps.google.com/*"
      ],
      "js": ["leads.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
