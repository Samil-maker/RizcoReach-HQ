---
import { words } from '../../lib/split';
import { home } from '../../content/home';
import type { Lang } from '../../i18n/utils';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = home[lang].manifesto;
---

<section class="mf section" aria-label={c.label}>
  <div class="container mf__grid">
    <p class="label label--line" data-reveal><span class="label__idx">(01)</span>{c.label}</p>
    <p class="mf__text" data-scrub set:html={words(c.text)} />
  </div>
</section>

<style>
  .mf__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3.2fr);
    gap: 32px;
    align-items: start;
  }
  .mf__grid .label {
    position: sticky;
    top: calc(var(--nav-h) + 24px);
    margin-top: 0.8em;
  }
  .mf__text {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.3vw, 4.4rem);
    line-height: 1.08;
    letter-spacing: -0.015em;
    text-wrap: pretty;
  }
  :global([lang='ar']) .mf__text {
    line-height: 1.45;
    letter-spacing: 0;
    font-size: clamp(1.7rem, 3.6vw, 3.6rem);
  }
  .mf__text :global(.sw) {
    color: color-mix(in srgb, var(--fg) calc(var(--o, 0) * 100%), #6b6b67);
    transition: color 120ms linear;
  }
  :global(html:not(.js)) .mf__text :global(.sw) {
    color: var(--fg);
  }
  @media (max-width: 860px) {
    .mf__grid {
      grid-template-columns: 1fr;
    }
    .mf__grid .label {
      position: static;
    }
  }
</style>
