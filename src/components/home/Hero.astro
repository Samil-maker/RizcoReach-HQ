---
import ChromeCanvas from '../ChromeCanvas.astro';
import Btn from '../Btn.astro';
import Icon from '../Icon.astro';
import { split } from '../../lib/split';
import { href, type Lang } from '../../i18n/utils';
import { home } from '../../content/home';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = home[lang].hero;
let i = 0;
const lines = c.title.map((l) => {
  const html = split(l, i);
  i += l.replace(/<[^>]+>/g, '').trim().split(/\s+/).length;
  return html;
});
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <ChromeCanvas />
  <div class="hero__inner container">
    <p class="hero__label label">
      <span class="pill__dot" aria-hidden="true"></span>{c.label}
    </p>
    <h1 id="hero-title" class="hero__title display">
      {lines.map((l) => <span class="hero__line" set:html={l} />)}
    </h1>

    <div class="hero__row">
      <p class="hero__lead lead">{c.sub}</p>
      <div class="hero__ctas" data-hero-ctas>
        <Btn href={href(lang, '/contact')} label={c.primary} variant="primary" size="lg" magnetic />
        <Btn href={href(lang, '/tools/website-audit')} label={c.secondary} icon="gauge" size="lg" />
      </div>
      <ul class="hero__points" role="list">
        {
          c.points.map((p) => (
            <li>
              <Icon name="check" size={14} stroke={2} />
              {p}
            </li>
          ))
        }
      </ul>
    </div>

    <dl class="hero__stats">
      {
        c.stats.map((s) => (
          <div class="hero__stat">
            <dt class="label">{s.label}</dt>
            <dd class="hero__stat-num tabular">
              <span data-count={s.value}>{s.value}</span>
              <span class="hero__stat-suf">{s.suffix}</span>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
  <a href="#intro" class="hero__scroll" aria-label={c.scroll}>
    <span class="label">{c.scroll}</span>
    <span class="hero__scroll-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: max(100svh, 720px);
    display: flex;
    align-items: flex-end;
    padding-top: calc(var(--nav-h) + 40px);
    padding-bottom: clamp(28px, 4vw, 48px);
    overflow: hidden;
    isolation: isolate;
  }
  .hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    gap: clamp(20px, 2.6vw, 34px);
  }
  .hero__label {
    color: var(--fg-2);
    gap: 12px;
    animation: hero-fade 1s var(--ease-out) 0.15s both;
  }
  .hero__title {
    display: grid;
    max-width: 14ch;
  }
  :global([lang='ar']) .hero__title {
    max-width: 16ch;
  }
  .hero__line {
    display: block;
  }
  .hero__title :global(em) {
    font-style: italic;
  }
  .hero__title :global(.wi) {
    animation: hero-rise 1.25s var(--ease-out) both;
    animation-delay: calc(var(--i) * 55ms + 120ms);
  }
  .hero__line:nth-child(2) :global(em .wi) {
    background: linear-gradient(172deg, #ffffff 0%, #e4e4e4 30%, #8f8f8f 52%, #f5f5f5 70%, #b9b9b9 100%);
    background-size: 100% 220%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  @keyframes hero-rise {
    from {
      transform: translate3d(0, 108%, 0) rotate(2deg);
    }
  }
  @keyframes hero-fade {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
  .hero__row {
    display: grid;
    grid-template-columns: minmax(0, 560px) auto;
    grid-template-areas:
      'lead ctas'
      'points ctas';
    justify-content: space-between;
    align-items: end;
    gap: 18px 48px;
    animation: hero-fade 1.1s var(--ease-out) 0.7s both;
  }
  .hero__lead {
    grid-area: lead;
  }
  .hero__points {
    grid-area: points;
  }
  .hero__ctas {
    grid-area: ctas;
  }
  .hero__points {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    font-size: var(--fs-sm);
    color: var(--fg-2);
  }
  .hero__points li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .hero__stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(16px, 3vw, 40px);
    border-top: 1px solid var(--line-2);
    animation: hero-fade 1.1s var(--ease-out) 0.95s both;
  }
  .hero__stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 4px;
    padding: 20px 0 0;
    padding-inline-end: 16px;
  }
  .hero__stat + .hero__stat {
    padding-inline-start: clamp(12px, 2vw, 28px);
    border-inline-start: 1px solid var(--line);
  }
  .hero__stat-num {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.6vw, 3.4rem);
    line-height: 1;
    direction: ltr;
    text-align: start;
  }
  :global([dir='rtl']) .hero__stat-num {
    text-align: end;
  }
  .hero__stat-suf {
    color: var(--fg-3);
    margin-inline-start: 2px;
    font-size: 0.7em;
  }
  .hero__scroll {
    position: absolute;
    z-index: 2;
    inset-inline-end: var(--gutter);
    top: 50%;
    display: grid;
    justify-items: center;
    gap: 14px;
    writing-mode: vertical-rl;
  }
  .hero__scroll-line {
    position: relative;
    width: 1px;
    height: 80px;
    background: var(--line-2);
    overflow: hidden;
  }
  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--fg);
    animation: scroll-line 2.4s var(--ease-io) infinite;
  }
  @keyframes scroll-line {
    0% {
      transform: translateY(-100%);
    }
    60%,
    100% {
      transform: translateY(100%);
    }
  }
  @media (max-width: 1080px) {
    .hero__scroll {
      display: none;
    }
  }
  @media (max-width: 900px) {
    .hero__row {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'lead' 'ctas' 'points';
    }
  }
  @media (max-width: 760px) {
    .hero {
      min-height: 100svh;
      padding-top: calc(var(--nav-h) + 14svh);
      padding-bottom: 24px;
    }
    .hero__inner {
      gap: 18px;
    }
    .hero__label {
      font-size: 0.6875rem;
      letter-spacing: 0.1em;
    }
    .hero__title {
      display: block;
      font-size: clamp(2.6rem, 12.4vw, 3.6rem);
      line-height: 0.98;
      text-wrap: balance;
    }
    .hero__line {
      display: inline;
    }
    .hero__line + .hero__line::before {
      content: ' ';
    }
    .hero__lead {
      font-size: 1rem;
    }
    .hero__points {
      gap: 6px 16px;
      font-size: var(--fs-xs);
    }
    .hero__stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .hero__stat:nth-child(3) {
      border-inline-start: 0;
      padding-inline-start: 0;
    }
    .hero__ctas {
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
    }
    .hero__ctas :global(.btn) {
      justify-content: space-between;
      min-height: 56px;
    }
  }
</style>
