---
/** Decorative, code-drawn product visuals for each service (no images). */
import Icon from './Icon.astro';
import type { Lang } from '../i18n/utils';

interface Props {
  kind: 'web' | 'seo' | 'ads';
  lang: Lang;
}
const { kind, lang } = Astro.props;
const ar = lang === 'ar';
const L = {
  perf: ar ? 'الأداء' : 'Performance',
  seo: ar ? 'السيو' : 'SEO',
  a11y: ar ? 'الوصول' : 'Accessibility',
  bp: ar ? 'الممارسات' : 'Best practices',
  query: ar ? 'تطوير مواقع دبي' : 'website development dubai',
  you: ar ? 'موقعك' : 'Your website',
  sponsored: ar ? 'الأول على الخريطة' : 'Top of Maps',
  leads: ar ? 'طلبات جديدة' : 'New leads',
  qualified: ar ? 'مؤهَّلة' : 'Qualified',
  live: ar ? 'مباشر' : 'Live',
  enquiry: ar ? 'استفسار جديد · فيلا في دبي هيلز' : 'New enquiry · Villa in Dubai Hills',
  enquiry2: ar ? 'استفسار جديد · تصميم مطبخ' : 'New enquiry · Kitchen fit-out',
  rank: ar ? 'الترتيب' : 'Ranking',
};
---

<div class={`sv sv--${kind}`} aria-hidden="true">
  {
    kind === 'web' && (
      <div class="sv-browser">
        <div class="sv-browser__bar">
          <span />
          <span />
          <span />
          <div class="sv-browser__url ltr">
            <Icon name="lock" size={11} />
            yourbusiness.ae
          </div>
        </div>
        <div class="sv-browser__body">
          <div class="sv-site">
            <div class="sv-site__nav">
              <i />
              <b />
              <b />
              <b />
              <em />
            </div>
            <div class="sv-site__hero">
              <div class="sv-site__h" />
              <div class="sv-site__h sv-site__h--2" />
              <div class="sv-site__p" />
              <div class="sv-site__btns">
                <span />
                <span />
              </div>
            </div>
            <div class="sv-site__cards">
              <span />
              <span />
              <span />
            </div>
          </div>
          <div class="sv-scores">
            {[L.perf, L.seo, L.a11y, L.bp].map((l, i) => (
              <div class="sv-score">
                <svg viewBox="0 0 48 48">
                  <circle cx="24" cy="24" r="20" class="sv-score__track" />
                  <circle cx="24" cy="24" r="20" class="sv-score__ring" style={`--d:${i * 120}ms`} />
                </svg>
                <span class="sv-score__n">100</span>
                <span class="sv-score__l">{l}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    )
  }
  {
    kind === 'seo' && (
      <div class="sv-serp">
        <div class="sv-serp__search">
          <Icon name="search" size={16} />
          <span>{L.query}</span>
        </div>
        <div class="sv-serp__results">
          <div class="sv-serp__item sv-serp__item--you">
            <span class="sv-serp__pos">#1</span>
            <div>
              <p class="sv-serp__site ltr">yourbusiness.ae</p>
              <p class="sv-serp__title">{L.you}</p>
              <div class="sv-serp__line" />
            </div>
            <span class="sv-serp__badge">
              <Icon name="pin" size={12} />
              {L.sponsored}
            </span>
          </div>
          {[2, 3, 4].map((n) => (
            <div class="sv-serp__item">
              <span class="sv-serp__pos">#{n}</span>
              <div>
                <div class="sv-serp__line sv-serp__line--s" />
                <div class="sv-serp__line" />
              </div>
            </div>
          ))}
        </div>
        <div class="sv-serp__chart">
          <span class="sv-serp__chart-l">{L.rank}</span>
          <svg viewBox="0 0 220 70" preserveAspectRatio="none">
            <path d="M0 62 C 30 60, 45 56, 65 50 S 105 40, 125 30 S 170 12, 220 6" class="sv-serp__path" pathLength="1" />
            <path d="M0 62 C 30 60, 45 56, 65 50 S 105 40, 125 30 S 170 12, 220 6 L220 70 L0 70Z" class="sv-serp__area" />
          </svg>
        </div>
      </div>
    )
  }
  {
    kind === 'ads' && (
      <div class="sv-ads">
        <div class="sv-ads__top">
          <span class="pill">
            <span class="pill__dot" />
            {L.live}
          </span>
          <span class="sv-ads__meta">Meta · Instagram</span>
        </div>
        <div class="sv-ads__kpis">
          <div>
            <span class="sv-ads__v ltr">100+</span>
            <span class="sv-ads__l">{L.leads}</span>
          </div>
          <div>
            <span class="sv-ads__v ltr">50+</span>
            <span class="sv-ads__l">{L.qualified}</span>
          </div>
        </div>
        <div class="sv-ads__bars">
          {[28, 36, 30, 46, 52, 48, 64, 70, 66, 82, 88, 96].map((h, i) => (
            <span style={`--h:${h}%;--i:${i}`} />
          ))}
        </div>
        <div class="sv-ads__feed">
          <div class="sv-ads__note">
            <Icon name="users" size={14} />
            {L.enquiry}
          </div>
          <div class="sv-ads__note sv-ads__note--2">
            <Icon name="users" size={14} />
            {L.enquiry2}
          </div>
        </div>
      </div>
    )
  }
</div>

<style>
  .sv {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 300px;
    display: grid;
    place-items: center;
    padding: clamp(16px, 3vw, 36px);
    border-radius: calc(var(--r) - 4px);
    background:
      radial-gradient(120% 90% at 80% 0%, rgb(255 255 255 / 0.09), transparent 60%),
      linear-gradient(180deg, #121212, #0b0b0b);
    border: 1px solid var(--line);
    overflow: hidden;
  }
  /* Browser */
  .sv-browser {
    width: 100%;
    max-width: 460px;
    border: 1px solid var(--line-2);
    border-radius: 12px;
    background: #0d0d0d;
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.6);
    overflow: hidden;
  }
  .sv-browser__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 12px;
    border-bottom: 1px solid var(--line);
    direction: ltr;
  }
  .sv-browser__bar > span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #333;
  }
  .sv-browser__url {
    margin-inline: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: 999px;
    background: #191919;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--fg-3);
  }
  .sv-browser__body {
    padding: 16px;
    display: grid;
    gap: 16px;
  }
  .sv-site {
    display: grid;
    gap: 12px;
  }
  .sv-site__nav {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .sv-site__nav i {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    background: #fff;
  }
  .sv-site__nav b {
    width: 26px;
    height: 5px;
    border-radius: 3px;
    background: #2a2a2a;
  }
  .sv-site__nav em {
    margin-inline-start: auto;
    width: 44px;
    height: 14px;
    border-radius: 999px;
    background: #fff;
  }
  .sv-site__hero {
    display: grid;
    gap: 8px;
    padding: 14px;
    border-radius: 8px;
    background: linear-gradient(120deg, #1b1b1b, #121212 60%, #262626);
  }
  .sv-site__h {
    height: 12px;
    width: 76%;
    border-radius: 4px;
    background: #e9e9e9;
  }
  .sv-site__h--2 {
    width: 52%;
    background: #9a9a9a;
  }
  .sv-site__p {
    height: 6px;
    width: 64%;
    border-radius: 3px;
    background: #333;
  }
  .sv-site__btns {
    display: flex;
    gap: 6px;
    margin-top: 4px;
  }
  .sv-site__btns span {
    width: 56px;
    height: 14px;
    border-radius: 999px;
    background: #fff;
  }
  .sv-site__btns span + span {
    background: transparent;
    border: 1px solid #444;
  }
  .sv-site__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }
  .sv-site__cards span {
    height: 34px;
    border-radius: 6px;
    background: #171717;
    border: 1px solid #222;
  }
  .sv-scores {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }
  .sv-score {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 6px;
  }
  .sv-score svg {
    width: 46px;
    height: 46px;
    transform: rotate(-90deg);
  }
  .sv-score__track {
    fill: none;
    stroke: #222;
    stroke-width: 3;
  }
  .sv-score__ring {
    fill: none;
    stroke: #fff;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 126;
    stroke-dashoffset: 126;
    transition: stroke-dashoffset 1.6s var(--ease-out) var(--d);
  }
  :global(.is-in) .sv-score__ring,
  :global(html:not(.js)) .sv-score__ring {
    stroke-dashoffset: 0;
  }
  .sv-score__n {
    position: absolute;
    top: 15px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
  }
  .sv-score__l {
    font-size: 9.5px;
    color: var(--fg-3);
    text-align: center;
    line-height: 1.2;
  }
  /* SERP */
  .sv-serp {
    width: 100%;
    max-width: 460px;
    display: grid;
    gap: 14px;
  }
  .sv-serp__search {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px;
    border: 1px solid var(--line-2);
    border-radius: 999px;
    background: #111;
    font-size: 0.875rem;
    color: var(--fg-2);
  }
  .sv-serp__results {
    display: grid;
    gap: 8px;
  }
  .sv-serp__item {
    display: grid;
    grid-template-columns: 30px 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: #0f0f0f;
    opacity: 0.55;
  }
  .sv-serp__item--you {
    opacity: 1;
    border-color: rgb(255 255 255 / 0.35);
    background: linear-gradient(90deg, #1d1d1d, #121212);
    box-shadow: 0 16px 40px rgb(0 0 0 / 0.5);
  }
  .sv-serp__pos {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg-3);
  }
  .sv-serp__item--you .sv-serp__pos {
    color: var(--fg);
  }
  .sv-serp__site {
    font-size: 10px;
    color: var(--fg-3);
    font-family: var(--font-mono);
  }
  .sv-serp__title {
    font-size: 0.9rem;
    font-weight: 560;
    margin-bottom: 6px;
  }
  .sv-serp__line {
    height: 5px;
    width: 90%;
    border-radius: 3px;
    background: #2a2a2a;
  }
  .sv-serp__line--s {
    width: 50%;
    height: 7px;
    margin-bottom: 6px;
    background: #3a3a3a;
  }
  .sv-serp__badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 8px;
    border-radius: 999px;
    background: #fff;
    color: #000;
    font-size: 10px;
    font-weight: 600;
    white-space: nowrap;
  }
  .sv-serp__chart {
    position: relative;
    height: 70px;
    padding: 0 4px;
  }
  .sv-serp__chart svg {
    width: 100%;
    height: 100%;
  }
  .sv-serp__chart-l {
    position: absolute;
    top: 0;
    inset-inline-start: 4px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--fg-3);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }
  .sv-serp__path {
    fill: none;
    stroke: #fff;
    stroke-width: 1.6;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 2s var(--ease-out) 0.2s;
    vector-effect: non-scaling-stroke;
  }
  :global(.is-in) .sv-serp__path,
  :global(html:not(.js)) .sv-serp__path {
    stroke-dashoffset: 0;
  }
  .sv-serp__area {
    fill: rgb(255 255 255 / 0.05);
  }
  :global([dir='rtl']) .sv-serp__chart svg {
    transform: scaleX(-1);
  }
  /* Ads */
  .sv-ads {
    width: 100%;
    max-width: 440px;
    display: grid;
    gap: 16px;
    padding: 18px;
    border: 1px solid var(--line-2);
    border-radius: 14px;
    background: #0d0d0d;
    box-shadow: 0 30px 80px rgb(0 0 0 / 0.6);
  }
  .sv-ads__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .sv-ads__meta {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-3);
  }
  .sv-ads__kpis {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .sv-ads__kpis > div {
    display: grid;
    gap: 2px;
    padding: 12px 14px;
    border-radius: 10px;
    background: #151515;
    border: 1px solid var(--line);
  }
  .sv-ads__v {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
  }
  .sv-ads__l {
    font-size: 11px;
    color: var(--fg-3);
  }
  .sv-ads__bars {
    height: 90px;
    display: flex;
    align-items: flex-end;
    gap: 6px;
  }
  .sv-ads__bars span {
    flex: 1;
    height: var(--h);
    border-radius: 3px 3px 0 0;
    background: linear-gradient(180deg, #fff, #555);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 1s var(--ease-out);
    transition-delay: calc(var(--i) * 50ms);
  }
  :global(.is-in) .sv-ads__bars span,
  :global(html:not(.js)) .sv-ads__bars span {
    transform: none;
  }
  .sv-ads__feed {
    display: grid;
    gap: 8px;
  }
  .sv-ads__note {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 10px;
    background: #fff;
    color: #000;
    font-size: 12px;
    font-weight: 520;
    animation: note-pop 6s var(--ease-out) infinite;
  }
  .sv-ads__note--2 {
    background: #1a1a1a;
    color: var(--fg-2);
    animation-delay: 3s;
  }
  @keyframes note-pop {
    0%,
    100% {
      transform: none;
    }
    6% {
      transform: translateY(-3px) scale(1.01);
    }
    12% {
      transform: none;
    }
  }
</style>
