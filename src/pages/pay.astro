---
/**
 * Client payment page. Every invoice link (/pay/<token>) is rewritten to this page in netlify.toml;
 * the script reads the token from the address and talks to netlify/functions/pay.mts.
 * Ziina sends the client back here with ?r=success, ?r=cancel or ?r=failure.
 *
 * The page mirrors the Ziina checkout it hands over to (light grey page, avatar with the invoice
 * message, "Pay RizcoReach.AE", a banner with the amount, a white card) so the jump feels like one flow.
 * The banner is the home hero's liquid chrome; public/pay-assets/banner.webp is its first frame, and the
 * same image is uploaded as the banner of the RizcoReach.AE Ziina profile.
 */
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/geist';
import '../styles/global.css';
import ChromeCanvas from '../components/ChromeCanvas.astro';
import Btn from '../components/Btn.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../i18n/utils';

const wa = `${SITE.whatsapp}?text=${encodeURIComponent('Hi, I have a question about my RizcoReach invoice')}`;
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#f3f3f3" />
    <title>Invoice payment | RizcoReach</title>
    <meta name="description" content="Secure invoice payment for RizcoReach clients." />
    <link rel="icon" type="image/png" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/pay-assets/banner.webp" as="image" type="image/webp" />
  </head>
  <body class="pay" data-view="loading">
    <div class="pay-test" data-test hidden>Test mode: no real money will be charged.</div>

    <div class="pay-page">
      <header class="pay-bar pay-wrap">
        <a href="/" class="pay-logo" aria-label="RizcoReach home">
          <img src="/brand/mark-80.webp" srcset="/brand/mark-80.webp 1x, /brand/mark-160.webp 2x" alt="" width="34" height="34" />
          <span class="pay-logo__word">RIZCOREACH<span>.AE</span></span>
        </a>
        <a class="pay-help" href={wa} data-wa><Icon name="whatsapp" size={16} />Need help?</a>
      </header>

      <main class="pay-wrap pay-grid">
        <section class="pay-intro" aria-label="Invoice from RizcoReach">
          <div class="pay-from">
            <span class="pay-avatar" aria-hidden="true"><img src="/brand/mark-80.webp" srcset="/brand/mark-80.webp 1x, /brand/mark-160.webp 2x" alt="" width="30" height="30" /></span>
            <p class="pay-bubble">RizcoReach invoice <span data-f="number"></span></p>
          </div>
          <h1 class="pay-h" data-h>Pay RizcoReach.AE</h1>
          <div class="pay-banner">
            <ChromeCanvas zoom={0.6} center={[0.5, 0.5]} centerMobile={[0.5, 0.5]} spread={2.2} spreadMobile={2.2} intro={false} sharp />
            <p class="pay-banner__amount" data-amount-line hidden></p>
          </div>
        </section>

        <section class="pay-panel" aria-live="polite">
          <ol class="pay-steps" data-steps hidden>
            <li>Review</li>
            <li>Pay with Ziina</li>
            <li>Receipt</li>
          </ol>

          <!-- Loading -->
          <div data-view="loading" class="pay-view" aria-label="Loading your invoice">
            <div class="pay-skel w35"></div>
            <div class="pay-skel w70"></div>
            <div class="pay-skel w55"></div>
            <div class="pay-skel tall"></div>
          </div>

          <!-- Invoice to pay -->
          <div data-view="invoice" class="pay-view" hidden>
            <dl class="pay-rows">
              <div><dt>Billed to</dt><dd data-f="client"></dd></div>
              <div data-row="description"><dt>For</dt><dd data-f="description"></dd></div>
              <div><dt>Issued</dt><dd data-f="created"></dd></div>
              <div class="pay-total"><dt>Amount due</dt><dd>AED <span data-f="amount"></span></dd></div>
            </dl>

            <div class="pay-co">
              <h2 class="pay-co__title"><Icon name="lock" size={17} stroke={1.9} />Secure checkout with Ziina</h2>
              <p class="pay-notice" data-notice hidden></p>
              <Btn label="Continue to Ziina" variant="primary" size="lg" class="pay-btn" data-pay />
              <p class="pay-err" data-error role="alert"></p>
              <ul class="pay-methods" role="list" aria-label="Accepted payment methods">
                <li>Apple Pay</li>
                <li>Google Pay</li>
                <li>Card</li>
              </ul>
              <p class="pay-partner">Ziina is our payment partner, licensed by the Central Bank of the UAE. Your card details go to Ziina, never to RizcoReach.</p>
              <p class="pay-fine">You'll come back here for your receipt after paying.</p>
            </div>
          </div>

          <!-- Confirming after Ziina sends the client back -->
          <div data-view="confirming" class="pay-view pay-state" hidden>
            <div class="pay-spinner" aria-hidden="true"></div>
            <p data-confirm-note>This takes a few seconds. Please keep this page open.</p>
          </div>

          <!-- Paid: receipt -->
          <div data-view="paid" class="pay-view" hidden>
            <p class="pay-paid"><span class="pay-paid__tick" aria-hidden="true"><Icon name="check" size={13} stroke={2.8} /></span>Paid</p>
            <dl class="pay-rows">
              <div class="pay-total"><dt>Amount paid</dt><dd>AED <span data-f="amount"></span></dd></div>
              <div><dt>Invoice</dt><dd data-f="number"></dd></div>
              <div><dt>Billed to</dt><dd data-f="client"></dd></div>
              <div data-row="description"><dt>For</dt><dd data-f="description"></dd></div>
              <div><dt>Paid on</dt><dd data-f="paid"></dd></div>
              <div data-row="via"><dt>Paid via</dt><dd>Ziina</dd></div>
              <div data-row="card"><dt>Card</dt><dd data-f="card"></dd></div>
              <div data-row="reference"><dt>Reference</dt><dd class="pay-ref" data-f="reference"></dd></div>
            </dl>
            <p class="pay-testnote" data-paid-test hidden>Test payment: no money was charged.</p>
            <p class="pay-thanks">Thank you. This is your receipt.</p>
            <Btn label="Save receipt as PDF" icon="download" class="pay-btn pay-btn--soft" data-print />
          </div>

          <!-- Cancelled invoice / bad link / server trouble -->
          <div data-view="void" class="pay-view pay-state" hidden>
            <p>There is nothing to pay. If you think this is a mistake, message us and we'll sort it out.</p>
            <Btn href={wa} label="Message us on WhatsApp" icon="whatsapp" class="pay-btn pay-btn--soft" data-wa />
          </div>
          <div data-view="missing" class="pay-view pay-state" hidden>
            <p>Please check the link you received, or message us and we'll send it again.</p>
            <Btn href={wa} label="Message us on WhatsApp" icon="whatsapp" class="pay-btn pay-btn--soft" data-wa />
          </div>
          <div data-view="error" class="pay-view pay-state" hidden>
            <p>We couldn't load this invoice. Please refresh the page in a moment, or message us.</p>
            <Btn href={wa} label="Message us on WhatsApp" icon="whatsapp" class="pay-btn pay-btn--soft" data-wa />
          </div>

          <noscript><p class="pay-state">This page needs JavaScript to load your invoice.</p></noscript>
        </section>
      </main>

      <footer class="pay-foot pay-wrap">
        <p>Questions about this invoice? <a class="pay-link" href={wa} data-wa>Message us on WhatsApp</a> or email <a class="pay-link" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
        <p>RizcoReach · Dubai, United Arab Emirates · <a class="pay-link" href="/">rizcoreach.ae</a></p>
      </footer>
    </div>
  </body>
</html>

<script>
  type View = 'loading' | 'invoice' | 'confirming' | 'paid' | 'void' | 'missing' | 'error';
  interface PublicInvoice {
    number: string;
    client: string;
    description: string;
    amount: number;
    currency: string;
    status: 'unpaid' | 'paid' | 'void';
    createdAt: number;
    paidAt: number | null;
    paidTest: boolean;
    reference: string;
    cardBrand: string;
    cardLast4: string;
    testMode: boolean;
    payable: boolean;
  }

  const $ = <T extends Element = HTMLElement>(sel: string) => document.querySelector(sel) as T;
  const $$ = (sel: string) => Array.from(document.querySelectorAll<HTMLElement>(sel));
  const token = decodeURIComponent(location.pathname.replace(/^\/pay\/?/, '').split('/')[0] || '');
  const ret = new URLSearchParams(location.search).get('r');
  const api = `/api/pay/${encodeURIComponent(token)}`;

  // "Pay RizcoReach.AE" is the heading on Ziina's own checkout, so the two pages read the same.
  const headings: Record<View, string> = {
    loading: ret === 'success' ? 'Confirming your payment' : 'Pay RizcoReach.AE',
    invoice: 'Pay RizcoReach.AE',
    confirming: 'Confirming your payment',
    paid: 'Payment received',
    void: 'Invoice cancelled',
    missing: 'Invoice not found',
    error: 'Something went wrong',
  };
  // Review, pay with Ziina, receipt.
  const steps: Partial<Record<View, number>> = { invoice: 1, confirming: 2, paid: 3 };

  let amountText = '';
  const money = (fils: number) => (fils / 100).toLocaleString('en-AE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const dubai = (ms: number, withTime = false) =>
    new Date(ms).toLocaleString('en-GB', {
      timeZone: 'Asia/Dubai',
      day: 'numeric',
      month: 'long',
      year: 'numeric',
      ...(withTime ? { hour: '2-digit', minute: '2-digit' } : {}),
    });

  function show(view: View) {
    $$('.pay-panel [data-view]').forEach((el) => (el.hidden = el.dataset.view !== view));
    document.body.dataset.view = view;
    $('[data-h]').textContent = headings[view];

    const pill = $('[data-amount-line]');
    pill.textContent = !amountText ? '' : view === 'invoice' ? `${amountText} to pay` : view === 'paid' ? `${amountText} paid` : view === 'confirming' ? amountText : '';
    pill.hidden = !pill.textContent;

    const step = steps[view] ?? 0;
    $('[data-steps]').hidden = !step;
    $$('[data-steps] li').forEach((li, i) => {
      li.classList.toggle('is-done', i + 1 < step || step === 3);
      if (i + 1 === step) li.setAttribute('aria-current', 'step');
      else li.removeAttribute('aria-current');
    });
  }

  function fill(inv: PublicInvoice) {
    const set = (f: string, v: string) => $$(`[data-f="${f}"]`).forEach((el) => (el.textContent = v));
    const viaZiina = !!inv.reference && inv.reference !== 'manual';
    amountText = `AED ${money(inv.amount)}`;
    set('number', inv.number);
    set('client', inv.client);
    set('description', inv.description);
    set('amount', money(inv.amount));
    set('created', dubai(inv.createdAt));
    set('paid', inv.paidAt ? dubai(inv.paidAt, true) : '');
    set('card', inv.cardLast4 ? `${inv.cardBrand ? inv.cardBrand.charAt(0) + inv.cardBrand.slice(1).toLowerCase() : 'Card'} ending ${inv.cardLast4}` : '');
    set('reference', viaZiina ? inv.reference : '');
    $$('[data-row="description"]').forEach((el) => (el.hidden = !inv.description));
    $$('[data-row="card"]').forEach((el) => (el.hidden = !inv.cardLast4));
    $$('[data-row="reference"], [data-row="via"]').forEach((el) => (el.hidden = !viaZiina));
    $('[data-test]').hidden = !inv.testMode;
    $('[data-paid-test]').hidden = !inv.paidTest;
    document.title = `Invoice ${inv.number} | RizcoReach`;
    const text = `text=${encodeURIComponent(`Hi, I have a question about RizcoReach invoice ${inv.number}`)}`;
    $$('[data-wa]').forEach((el) => {
      const a = el as HTMLAnchorElement;
      a.href = a.href.replace(/text=[^&]*/, text);
    });
  }

  function notice(text: string) {
    const el = $('[data-notice]');
    el.textContent = text;
    el.hidden = !text;
  }

  function render(inv: PublicInvoice) {
    fill(inv);
    if (inv.status === 'paid') return show('paid');
    if (inv.status === 'void') return show('void');
    $<HTMLButtonElement>('[data-pay]').disabled = !inv.payable;
    if (!inv.payable) notice('Online payment is not available for this invoice right now. Please message us and we will help.');
    show('invoice');
  }

  async function getJSON(url: string, init?: RequestInit) {
    const res = await fetch(url, { cache: 'no-store', ...init });
    const data = await res.json().catch(() => ({}));
    return { ok: res.ok, status: res.status, data };
  }

  async function confirm() {
    show('confirming');
    const note = $('[data-confirm-note]');
    for (let i = 0; i < 10; i++) {
      const { ok, data } = await getJSON(`${api}/status`);
      if (ok && data.invoice) {
        if (data.invoice.status === 'paid') {
          history.replaceState(null, '', location.pathname);
          return render(data.invoice);
        }
        if (['failed', 'canceled'].includes(data.last)) {
          render(data.invoice);
          return notice(data.last === 'failed' ? "The payment didn't go through and nothing was charged. You can try again, or use another card." : 'The payment was cancelled and nothing was charged.');
        }
      }
      if (i === 3) note.textContent = 'Still confirming with Ziina. Please keep this page open.';
      await new Promise((r) => setTimeout(r, 2500));
    }
    const { data } = await getJSON(api);
    if (data.invoice) render(data.invoice);
    notice("We're still waiting for Ziina to confirm. If money left your account, you don't need to pay again: we'll confirm on WhatsApp shortly.");
  }

  async function start() {
    if (!token) return show('missing');
    const { ok, status, data } = await getJSON(api).catch(() => ({ ok: false, status: 0, data: {} as Record<string, unknown> }));
    if (!ok || !data.invoice) return show(status === 404 ? 'missing' : 'error');
    const inv = data.invoice as PublicInvoice;
    if (inv.status === 'unpaid' && ret === 'success') {
      fill(inv);
      return confirm();
    }
    render(inv);
    if (inv.status === 'unpaid' && ret === 'cancel') notice('Payment cancelled. Nothing was charged.');
    if (inv.status === 'unpaid' && ret === 'failure') notice("The payment didn't go through and nothing was charged. You can try again, or use another card.");
    if (ret) history.replaceState(null, '', location.pathname);
  }

  const payBtn = $<HTMLButtonElement>('[data-pay]');
  const payLabels = Array.from(payBtn.querySelectorAll<HTMLElement>('.btn__label > span'));
  const busy = (on: boolean) => {
    payBtn.disabled = on;
    payBtn.classList.toggle('is-busy', on);
    payBtn.setAttribute('aria-busy', String(on));
    payLabels.forEach((s) => (s.textContent = on ? 'Opening Ziina…' : 'Continue to Ziina'));
  };

  payBtn.addEventListener('click', async () => {
    const err = $('[data-error]');
    err.textContent = '';
    busy(true);
    const { ok, data } = await getJSON(`${api}/checkout`, { method: 'POST' }).catch(() => ({ ok: false, data: {} as Record<string, unknown> }));
    if (ok && typeof data.url === 'string') {
      location.href = data.url;
      return;
    }
    busy(false);
    const messages: Record<string, string> = {
      already_paid: 'This invoice is already paid.',
      void: 'This invoice was cancelled.',
      rate_limited: 'Too many tries in a short time. Please wait a few minutes and try again.',
      not_configured: 'Online payment is not available right now. Please message us and we will help.',
    };
    err.textContent = messages[data.error as string] || "We couldn't open the payment page. Please try again in a moment, or message us.";
    if (data.error === 'already_paid') start();
  });

  // Coming back with the browser's back button from Ziina restores this page from cache, still busy.
  window.addEventListener('pageshow', (e) => e.persisted && busy(false));

  $('[data-print]').addEventListener('click', () => window.print());

  show('loading');
  start();
</script>

<style is:global>
  /* Light theme in Ziina's checkout palette, in Archivo (closest open font to Ziina's lettering). */
  .pay {
    color-scheme: light;
    --bg: #f3f3f3;
    --bg-2: #ffffff;
    --surface: #ffffff;
    --surface-2: #ebebeb;
    --surface-3: #dedede;
    --fg: #0a0a0a;
    --fg-2: #4a4a4a;
    --fg-3: #6b6b6b;
    --line: rgb(0 0 0 / 0.08);
    --line-2: rgb(0 0 0 / 0.14);
    --success: #dff3e3;
    --font-sans: 'Archivo Variable', 'Geist Variable', ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif;
    font-stretch: 104%;
    background: var(--bg);
    color: var(--fg);
  }
  .pay ::selection {
    background: #000;
    color: #fff;
  }
  .pay-wrap {
    width: min(100% - 2 * var(--gutter), 1080px);
    margin-inline: auto;
  }
  .pay-test {
    position: sticky;
    top: 0;
    z-index: 5;
    background: #f5c451;
    color: #1d1500;
    text-align: center;
    font-size: var(--fs-xs);
    font-weight: 600;
    padding: 8px 16px;
  }
  .pay-page {
    min-height: 100svh;
    display: grid;
    grid-template-rows: auto 1fr auto;
  }

  /* Top bar: our logo where Ziina shows theirs */
  .pay-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: calc(env(safe-area-inset-top) + 18px) 18px;
  }
  .pay-logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }
  .pay-logo img {
    width: 34px;
    height: 34px;
    filter: invert(1);
  }
  /* Same lockup as the site nav (Nav.astro) */
  .pay-logo__word {
    font-family: 'Geist Variable', sans-serif;
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.2em;
  }
  .pay-logo__word span {
    font-weight: 300;
    opacity: 0.5;
    letter-spacing: 0.08em;
  }
  .pay-help {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 36px;
    padding: 0 14px;
    border-radius: 999px;
    background: var(--surface);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.06);
    font-size: var(--fs-xs);
    font-weight: 500;
    transition: background-color var(--t) var(--ease-out);
  }
  .pay-help:hover {
    background: var(--surface-2);
  }

  /* Two columns like Ziina: who is asking on the left, the card on the right */
  .pay-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 480px);
    align-items: center;
    gap: 40px 72px;
    padding-block: 24px 48px;
  }
  .pay-intro {
    display: grid;
    gap: 22px;
    max-width: 470px;
  }
  .pay-from {
    display: flex;
    align-items: flex-end;
  }
  .pay-avatar {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: #0a0a0a;
  }
  .pay-avatar img {
    width: 30px;
    height: 30px;
  }
  .pay-bubble {
    margin-inline-start: 6px;
    margin-bottom: -12px;
    padding: 9px 16px;
    border-radius: 999px;
    background: var(--surface);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.05), 0 6px 18px rgb(0 0 0 / 0.07);
    font-size: var(--fs-sm);
    color: var(--fg-2);
    overflow-wrap: anywhere;
  }
  .pay-h {
    font-size: clamp(2.3rem, 4.6vw, 3.5rem);
    font-weight: 700;
    font-stretch: 113%;
    line-height: 1.02;
    letter-spacing: -0.015em;
    margin-top: 4px;
  }
  .pay-banner {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 22px;
    overflow: hidden;
    isolation: isolate;
    background: #050505 url('/pay-assets/banner.webp') center / cover no-repeat;
  }
  .pay .pay-banner .chrome {
    background: none;
  }
  .pay .pay-banner .chrome__scrim {
    display: none;
  }
  .pay-banner__amount {
    position: absolute;
    z-index: 2;
    inset-inline-start: 14px;
    bottom: 14px;
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--surface);
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.18);
    font-size: var(--fs-sm);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  /* The card: same white card and black pill as Ziina's checkout */
  .pay-panel {
    display: grid;
    gap: 22px;
    background: var(--surface);
    border-radius: 24px;
    padding: clamp(22px, 3vw, 34px);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.04), 0 20px 50px -24px rgb(0 0 0 / 0.18);
  }
  .pay-view {
    display: grid;
    gap: 22px;
  }
  .pay-steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    padding: 0;
    list-style: none;
    font-size: 0.75rem;
    color: var(--fg-3);
    counter-reset: step;
  }
  .pay-steps li {
    counter-increment: step;
    padding-top: 9px;
    border-top: 3px solid var(--surface-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .pay-steps li::before {
    content: counter(step) '  ';
    font-weight: 600;
  }
  .pay-steps li.is-done {
    border-top-color: var(--fg-3);
  }
  .pay-steps li[aria-current] {
    border-top-color: var(--fg);
    color: var(--fg);
    font-weight: 600;
  }
  .pay-rows {
    display: grid;
  }
  .pay-rows > div {
    display: grid;
    grid-template-columns: 100px minmax(0, 1fr);
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-sm);
  }
  .pay-rows > div:first-child {
    padding-top: 0;
  }
  .pay-rows dt {
    color: var(--fg-3);
  }
  .pay-rows dd {
    margin: 0;
    text-align: end;
    overflow-wrap: anywhere;
  }
  .pay-rows .pay-total {
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    border-bottom: 0;
    padding-bottom: 0;
  }
  .pay-rows .pay-total dt {
    color: var(--fg);
    font-weight: 600;
  }
  .pay-rows .pay-total dd {
    white-space: nowrap;
    font-size: clamp(1.3rem, 5.4vw, 1.6rem);
    font-weight: 700;
    font-stretch: 113%;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }
  .pay-rows > .pay-total:first-child {
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }
  .pay-ref {
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums;
  }

  .pay-co {
    display: grid;
    gap: 14px;
    padding-top: 22px;
