---
/**
 * Client payment page. Every invoice link (/pay/<token>) is rewritten to this page in netlify.toml;
 * the script reads the token from the address and talks to netlify/functions/pay.mts.
 * Ziina sends the client back here with ?r=success, ?r=cancel or ?r=failure.
 *
 * Layout: liquid chrome header (same shader as the home hero), the invoice card, then a white block
 * that previews Ziina's own black-and-white checkout so the jump to it feels expected.
 */
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import ChromeCanvas from '../components/ChromeCanvas.astro';
import Btn from '../components/Btn.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../i18n/utils';

const wa = `${SITE.whatsapp}?text=${encodeURIComponent('Hi, I have a question about my RizcoReach invoice')}`;
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#050505" />
    <title>Invoice payment | RizcoReach</title>
    <meta name="description" content="Secure invoice payment for RizcoReach clients." />
    <link rel="icon" type="image/png" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body class="pay" data-view="loading">
    <div class="pay-test" data-test hidden>Test mode: no real money will be charged.</div>

    <header class="pay-top">
      <ChromeCanvas center={[0.8, 0.5]} spread={1.05} centerMobile={[0.9, 0.78]} spreadMobile={0.6} fpsMobile={30} />
      <div class="pay-top__inner pay-col">
        <a href="/" class="pay-logo" aria-label="RizcoReach home">
          <img src="/brand/mark-80.webp" srcset="/brand/mark-80.webp 1x, /brand/mark-160.webp 2x" alt="" width="40" height="40" />
          <span class="pay-logo__word">RIZCOREACH<span>.AE</span></span>
        </a>
        <div class="pay-top__title">
          <p class="label"><span class="pill__dot" aria-hidden="true"></span><span>Invoice <span class="ltr" data-f="number"></span></span></p>
          <h1 class="h2 pay-h"><span data-h1>Your</span> <em class="chrome-text" data-h2>invoice</em></h1>
        </div>
      </div>
    </header>

    <main class="pay-main pay-col" aria-live="polite">
      <!-- Loading -->
      <div data-view="loading" class="card pay-card" aria-label="Loading your invoice">
        <div class="pay-skel w30"></div>
        <div class="pay-skel w60 tall"></div>
        <div class="pay-skel w45"></div>
      </div>

      <!-- Invoice to pay -->
      <div data-view="invoice" class="pay-stack" hidden>
        <article class="card pay-card">
          <p class="label">Billed to</p>
          <p class="pay-client" data-f="client"></p>
          <p class="pay-desc" data-f="description"></p>
          <div class="pay-due">
            <p class="label">Amount due</p>
            <p class="pay-amount tabular"><span class="pay-amount__cur">AED</span><span data-f="amount"></span></p>
          </div>
          <dl class="pay-rows">
            <div><dt>Issued</dt><dd data-f="created"></dd></div>
          </dl>
        </article>

        <section class="zi" aria-labelledby="zi-title">
          <div class="zi__head">
            <span class="zi__lock" aria-hidden="true"><Icon name="lock" size={18} stroke={1.8} /></span>
            <h2 class="h4" id="zi-title">Secure checkout with Ziina</h2>
          </div>
          <ul class="zi__methods" role="list" aria-label="Accepted payment methods">
            <li class="pill">Apple Pay</li>
            <li class="pill">Google Pay</li>
            <li class="pill">Card</li>
          </ul>
          <p class="zi__notice" data-notice hidden></p>
          <Btn label="Continue to Ziina" variant="primary" size="lg" class="zi__btn" data-pay />
          <p class="zi__err" data-error role="alert"></p>
          <p class="zi__partner">Ziina is our payment partner, licensed by the Central Bank of the UAE. Your card details go to Ziina, never to RizcoReach.</p>
          <p class="zi__fine">You'll come back here for your receipt after paying.</p>
        </section>
      </div>

      <!-- Confirming after Ziina sends the client back -->
      <div data-view="confirming" class="card pay-card pay-state" hidden>
        <div class="pay-spinner" aria-hidden="true"></div>
        <p data-confirm-note>This takes a few seconds. Please keep this page open.</p>
      </div>

      <!-- Paid: receipt -->
      <div data-view="paid" class="pay-stack" hidden>
        <article class="card pay-card">
          <p class="pay-paid"><span class="pay-paid__tick" aria-hidden="true"><Icon name="check" size={14} stroke={2.6} /></span>Paid</p>
          <p class="label">Amount paid</p>
          <p class="pay-amount tabular"><span class="pay-amount__cur">AED</span><span data-f="amount"></span></p>
          <p class="pay-desc">Thank you. This is your receipt.</p>
          <dl class="pay-rows">
            <div><dt>Invoice</dt><dd class="ltr" data-f="number"></dd></div>
            <div><dt>Billed to</dt><dd data-f="client"></dd></div>
            <div data-row="description"><dt>For</dt><dd data-f="description"></dd></div>
            <div><dt>Paid on</dt><dd data-f="paid"></dd></div>
            <div data-row="via"><dt>Paid via</dt><dd>Ziina</dd></div>
            <div data-row="card"><dt>Card</dt><dd data-f="card"></dd></div>
            <div data-row="reference"><dt>Reference</dt><dd class="pay-mono" data-f="reference"></dd></div>
          </dl>
          <p class="pay-testnote" data-paid-test hidden>Test payment: no money was charged.</p>
        </article>
        <Btn label="Save receipt as PDF" icon="download" class="pay-wide" data-print />
      </div>

      <!-- Cancelled invoice / bad link / server trouble -->
      <div data-view="void" class="card pay-card pay-state" hidden>
        <p>There is nothing to pay. If you think this is a mistake, message us and we'll sort it out.</p>
        <Btn href={wa} label="Message us on WhatsApp" icon="whatsapp" class="pay-wide" data-wa />
      </div>
      <div data-view="missing" class="card pay-card pay-state" hidden>
        <p>Please check the link you received, or message us and we'll send it again.</p>
        <Btn href={wa} label="Message us on WhatsApp" icon="whatsapp" class="pay-wide" data-wa />
      </div>
      <div data-view="error" class="card pay-card pay-state" hidden>
        <p>We couldn't load this invoice. Please refresh the page in a moment, or message us.</p>
        <Btn href={wa} label="Message us on WhatsApp" icon="whatsapp" class="pay-wide" data-wa />
      </div>

      <noscript><p class="card pay-card pay-state">This page needs JavaScript to load your invoice.</p></noscript>
    </main>

    <footer class="pay-foot pay-col">
      <p>Questions about this invoice? <a class="pay-link" href={wa} data-wa>Message us on WhatsApp</a> or email <a class="pay-link" href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      <p class="pay-foot__small">RizcoReach · Dubai, United Arab Emirates · <a class="pay-link" href="/">rizcoreach.ae</a></p>
    </footer>
  </body>
</html>

<script>
  type View = 'loading' | 'invoice' | 'confirming' | 'paid' | 'void' | 'missing' | 'error';
  interface PublicInvoice {
    number: string;
    client: string;
    description: string;
    amount: number;
    currency: string;
    status: 'unpaid' | 'paid' | 'void';
    createdAt: number;
    paidAt: number | null;
    paidTest: boolean;
    reference: string;
    cardBrand: string;
    cardLast4: string;
    testMode: boolean;
    payable: boolean;
  }

  const $ = <T extends Element = HTMLElement>(sel: string) => document.querySelector(sel) as T;
  const $$ = (sel: string) => Array.from(document.querySelectorAll<HTMLElement>(sel));
  const token = decodeURIComponent(location.pathname.replace(/^\/pay\/?/, '').split('/')[0] || '');
  const ret = new URLSearchParams(location.search).get('r');
  const api = `/api/pay/${encodeURIComponent(token)}`;

  // Header line per view: plain words, then the chrome italic words.
  const headings: Record<View, [string, string]> = {
    loading: ['Your', 'invoice'],
    invoice: ['Your', 'invoice'],
    confirming: ['Confirming', 'payment'],
    paid: ['Payment', 'received'],
    void: ['Invoice', 'cancelled'],
    missing: ['Invoice', 'not found'],
    error: ['Something', 'went wrong'],
  };

  const money = (fils: number) => (fils / 100).toLocaleString('en-AE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const dubai = (ms: number, withTime = false) =>
    new Date(ms).toLocaleString('en-GB', {
      timeZone: 'Asia/Dubai',
      day: 'numeric',
      month: 'long',
      year: 'numeric',
      ...(withTime ? { hour: '2-digit', minute: '2-digit' } : {}),
    });

  function show(view: View) {
    $$('main [data-view]').forEach((el) => (el.hidden = el.dataset.view !== view));
    document.body.dataset.view = view;
    $('[data-h1]').textContent = headings[view][0];
    $('[data-h2]').textContent = headings[view][1];
  }

  function fill(inv: PublicInvoice) {
    const set = (f: string, v: string) => $$(`[data-f="${f}"]`).forEach((el) => (el.textContent = v));
    const viaZiina = !!inv.reference && inv.reference !== 'manual';
    set('number', inv.number);
    set('client', inv.client);
    set('description', inv.description);
    set('amount', money(inv.amount));
    set('created', dubai(inv.createdAt));
    set('paid', inv.paidAt ? dubai(inv.paidAt, true) : '');
    set('card', inv.cardLast4 ? `${inv.cardBrand ? inv.cardBrand.charAt(0) + inv.cardBrand.slice(1).toLowerCase() : 'Card'} ending ${inv.cardLast4}` : '');
    set('reference', viaZiina ? inv.reference : '');
    $$('[data-row="description"], .pay-desc[data-f="description"]').forEach((el) => (el.hidden = !inv.description));
    $$('[data-row="card"]').forEach((el) => (el.hidden = !inv.cardLast4));
    $$('[data-row="reference"], [data-row="via"]').forEach((el) => (el.hidden = !viaZiina));
    $('[data-test]').hidden = !inv.testMode;
    $('[data-paid-test]').hidden = !inv.paidTest;
    document.title = `Invoice ${inv.number} | RizcoReach`;
    const text = `text=${encodeURIComponent(`Hi, I have a question about RizcoReach invoice ${inv.number}`)}`;
    $$('[data-wa]').forEach((el) => {
      const a = el as HTMLAnchorElement;
      a.href = a.href.replace(/text=[^&]*/, text);
    });
  }

  function notice(text: string) {
    const el = $('[data-notice]');
    el.textContent = text;
    el.hidden = !text;
  }

  function render(inv: PublicInvoice) {
    fill(inv);
    if (inv.status === 'paid') return show('paid');
    if (inv.status === 'void') return show('void');
    $<HTMLButtonElement>('[data-pay]').disabled = !inv.payable;
    if (!inv.payable) notice('Online payment is not available for this invoice right now. Please message us and we will help.');
    show('invoice');
  }

  async function getJSON(url: string, init?: RequestInit) {
    const res = await fetch(url, { cache: 'no-store', ...init });
    const data = await res.json().catch(() => ({}));
    return { ok: res.ok, status: res.status, data };
  }

  async function confirm() {
    show('confirming');
    const note = $('[data-confirm-note]');
    for (let i = 0; i < 10; i++) {
      const { ok, data } = await getJSON(`${api}/status`);
      if (ok && data.invoice) {
        if (data.invoice.status === 'paid') {
          history.replaceState(null, '', location.pathname);
          return render(data.invoice);
        }
        if (['failed', 'canceled'].includes(data.last)) {
          render(data.invoice);
          return notice(data.last === 'failed' ? "The payment didn't go through and nothing was charged. You can try again, or use another card." : 'The payment was cancelled and nothing was charged.');
        }
      }
      if (i === 3) note.textContent = 'Still confirming with Ziina. Please keep this page open.';
      await new Promise((r) => setTimeout(r, 2500));
    }
    const { data } = await getJSON(api);
    if (data.invoice) render(data.invoice);
    notice("We're still waiting for Ziina to confirm. If money left your account, you don't need to pay again: we'll confirm on WhatsApp shortly.");
  }

  async function start() {
    if (!token) return show('missing');
    const { ok, status, data } = await getJSON(api).catch(() => ({ ok: false, status: 0, data: {} as Record<string, unknown> }));
    if (!ok || !data.invoice) return show(status === 404 ? 'missing' : 'error');
    const inv = data.invoice as PublicInvoice;
    if (inv.status === 'unpaid' && ret === 'success') {
      fill(inv);
      return confirm();
    }
    render(inv);
    if (inv.status === 'unpaid' && ret === 'cancel') notice('Payment cancelled. Nothing was charged.');
    if (inv.status === 'unpaid' && ret === 'failure') notice("The payment didn't go through and nothing was charged. You can try again, or use another card.");
    if (ret) history.replaceState(null, '', location.pathname);
  }

  const payBtn = $<HTMLButtonElement>('[data-pay]');
  const payLabels = Array.from(payBtn.querySelectorAll<HTMLElement>('.btn__label > span'));
  const busy = (on: boolean) => {
    payBtn.disabled = on;
    payBtn.classList.toggle('is-busy', on);
    payBtn.setAttribute('aria-busy', String(on));
    payLabels.forEach((s) => (s.textContent = on ? 'Opening Ziina…' : 'Continue to Ziina'));
  };

  payBtn.addEventListener('click', async () => {
    const err = $('[data-error]');
    err.textContent = '';
    busy(true);
    const { ok, data } = await getJSON(`${api}/checkout`, { method: 'POST' }).catch(() => ({ ok: false, data: {} as Record<string, unknown> }));
    if (ok && typeof data.url === 'string') {
      location.href = data.url;
      return;
    }
    busy(false);
    const messages: Record<string, string> = {
      already_paid: 'This invoice is already paid.',
      void: 'This invoice was cancelled.',
      rate_limited: 'Too many tries in a short time. Please wait a few minutes and try again.',
      not_configured: 'Online payment is not available right now. Please message us and we will help.',
    };
    err.textContent = messages[data.error as string] || "We couldn't open the payment page. Please try again in a moment, or message us.";
    if (data.error === 'already_paid') start();
  });

  // Coming back with the browser's back button from Ziina restores this page from cache, still busy.
  window.addEventListener('pageshow', (e) => e.persisted && busy(false));

  $('[data-print]').addEventListener('click', () => window.print());

  start();
</script>

<style is:global>
  .pay {
    background: var(--bg);
  }
  .pay-col {
    width: min(100% - 2 * var(--gutter), 560px);
    margin-inline: auto;
  }
  .pay-test {
    position: sticky;
    top: 0;
    z-index: 5;
    background: #f5c451;
    color: #1d1500;
    text-align: center;
    font-size: var(--fs-xs);
    font-weight: 600;
    padding: 8px 16px;
  }

  /* Header: the home hero's liquid chrome in a short band */
  .pay-top {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 380px;
    display: flex;
    padding-block: calc(env(safe-area-inset-top) + 24px) 92px;
  }
  .pay-top__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 40px;
  }
  .pay-top .chrome__scrim {
    background:
      linear-gradient(to top, var(--bg) 0%, rgb(5 5 5 / 0.72) 26%, transparent 62%),
      linear-gradient(to right, rgb(5 5 5 / 0.55) 0%, transparent 45%) !important;
  }
  .pay-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    align-self: flex-start;
  }
  .pay-logo img {
    width: 40px;
    height: 40px;
  }
  /* Same lockup as the site nav (Nav.astro) */
  .pay-logo__word {
    font-family: 'Geist Variable', var(--font-sans);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.2em;
  }
  .pay-logo__word span {
    font-weight: 300;
    opacity: 0.5;
    letter-spacing: 0.08em;
  }
  .pay-top__title {
    display: grid;
    gap: 16px;
  }
  .pay-top__title .label {
    color: var(--fg-2);
  }
  .pay-h {
    font-size: clamp(2.75rem, 6vw, 4.6rem);
  }
  .pay-h em {
    display: inline-block;
    padding-inline-end: 0.06em;
  }

  /* Main column, pulled up into the chrome band */
  .pay-main {
    position: relative;
    z-index: 3;
    margin-top: -60px;
    display: grid;
  }
  .pay-stack {
    display: grid;
    gap: 12px;
  }
  .pay-card {
    display: grid;
    align-content: start;
    gap: 10px;
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.8);
  }
  .pay-client {
    font-size: 1.3rem;
    font-weight: 560;
    line-height: 1.3;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }
  .pay-desc {
    color: var(--fg-2);
    font-size: var(--fs-sm);
    overflow-wrap: anywhere;
  }
  .pay-due {
    display: grid;
    gap: 10px;
    margin-top: 14px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }
  .pay-amount {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 15vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }
  .pay-amount__cur {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    letter-spacing: var(--tracking-label);
    color: var(--fg-3);
    margin-top: 0.7em;
  }
  .pay-rows {
    display: grid;
    margin-top: 12px;
    border-top: 1px solid var(--line);
  }
  .pay-rows > div {
    display: grid;
    grid-template-columns: 104px minmax(0, 1fr);
    gap: 12px;
    padding: 13px 0;
    border-bottom: 1px solid var(--line);
    font-size: var(--fs-sm);
  }
  .pay-rows > div:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }
  .pay-rows dt {
    color: var(--fg-3);
  }
  .pay-rows dd {
    margin: 0;
    text-align: end;
    overflow-wrap: anywhere;
  }
  .pay-mono {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }
  .pay-wide {
    width: 100%;
    justify-content: space-between;
  }

  /* Checkout handoff: previews Ziina's own white, black and grey checkout */
  .zi {
    --fg: #0a0a0a;
    --fg-2: #474744;
    --fg-3: #5f5f5b;
    --bg: #ffffff;
    --bg-2: #ffffff;
    --line: rgb(0 0 0 / 0.1);
    --line-2: rgb(0 0 0 / 0.16);
    color-scheme: light;
    position: relative;
    background: #fff;
    color: var(--fg);
    border-radius: var(--r);
    padding: clamp(24px, 3vw, 40px);
    display: grid;
    gap: 18px;
  }
  .zi ::selection {
    background: #000;
    color: #fff;
  }
  .zi__head {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .zi__lock {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--fg);
    color: var(--bg);
  }
  .zi__methods {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .zi__methods .pill {
    color: var(--fg);
    font-weight: 500;
  }
  .zi__btn {
    width: 100%;
    justify-content: space-between;
  }
  .zi__btn.is-busy {
    opacity: 0.85;
  }
  .zi__notice {
    padding: 12px 14px;
    border-radius: var(--r-sm);
    background: #f2f2ef;
    border: 1px solid var(--line);
    color: var(--fg-2);
    font-size: var(--fs-sm);
  }
  .zi__err {
    margin-top: -6px;
    color: #b3261e;
    font-size: var(--fs-sm);
  }
  .zi__err:empty {
    display: none;
  }
  .zi__partner {
    padding-top: 18px;
    border-top: 1px solid var(--line);
    color: var(--fg-2);
    font-size: var(--fs-sm);
    line-height: 1.55;
  }
  .zi__fine {
    margin-top: -8px;
    color: var(--fg-3);
    font-size: var(--fs-xs);
  }

  /* Receipt */
  .pay-paid {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    justify-self: start;
    margin-bottom: 10px;
    padding: 5px 14px 5px 5px;
    border-radius: 999px;
    background: var(--success);
    color: #0b3b16;
    font-size: var(--fs-xs);
    font-weight: 600;
  }
  .pay-paid__tick {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #0b3b16;
    color: var(--success);
  }
  .pay-testnote {
    margin-top: 6px;
    color: #f5c451;
    font-size: var(--fs-xs);
  }

  /* Confirming, cancelled, missing, error */
  .pay-state {
    justify-items: center;
    text-align: center;
    gap: 18px;
    padding-block: 40px;
    color: var(--fg-2);
  }
  .pay-spinner {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 3px solid var(--line-2);
    border-top-color: var(--fg);
    animation: pay-spin 0.9s linear infinite;
  }
  .pay-skel {
    height: 14px;
    border-radius: 8px;
    background: linear-gradient(90deg, var(--surface-2), var(--surface-3), var(--surface-2));
    background-size: 200% 100%;
    animation: pay-shimmer 1.4s linear infinite;
  }
  .pay-skel.tall {
    height: 56px;
    margin: 12px 0;
  }
  .pay-skel.w30 { width: 30%; }
  .pay-skel.w45 { width: 45%; }
  .pay-skel.w60 { width: 60%; }
  @keyframes pay-shimmer {
    to { background-position: -200% 0; }
  }
  @keyframes pay-spin {
    to { transform: rotate(360deg); }
  }

  .pay-foot {
    display: grid;
    gap: 8px;
    padding-block: 36px calc(env(safe-area-inset-bottom) + 36px);
    text-align: center;
    color: var(--fg-3);
    font-size: var(--fs-xs);
  }
  .pay-foot__small {
    font-size: 0.75rem;
  }
  .pay-link {
    color: var(--fg-2);
