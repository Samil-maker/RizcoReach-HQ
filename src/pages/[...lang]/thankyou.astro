---
import Base from '../../layouts/Base.astro';
import Btn from '../../components/Btn.astro';
import Icon from '../../components/Icon.astro';
import { split } from '../../lib/split';
import { localeStaticPaths, href, SITE, type Lang } from '../../i18n/utils';

export const getStaticPaths = localeStaticPaths;
const { lang } = Astro.props as { lang: Lang };
const t = {
  en: {
    title: 'Application received | RizcoReach',
    kicker: 'Application received',
    h: 'Thank you. <em>We’re on it.</em>',
    sub: 'We’ve got your details and will be in touch within 24 hours to confirm your strategy call. Keep an eye on your inbox and WhatsApp.',
    nextTitle: 'What happens next',
    next: [
      { t: 'We read what you submitted', d: 'Your business, your situation and your goals, so we come prepared, not cold.' },
      { t: 'We contact you within 24 hours', d: 'By email or WhatsApp, to lock in a time for your free call.' },
      { t: 'Free 30-minute strategy session', d: 'We talk through your business and whether our approach is the right fit. No hard sell.' },
    ],
    whileWait: 'While you wait',
    audit: 'Run a free website audit',
    home: 'Back to the website',
    wa: 'Message us on WhatsApp',
  },
  ar: {
    title: 'تم استلام طلبك | RizcoReach',
    kicker: 'تم استلام الطلب',
    h: 'شكراً لك. <em>نحن على الأمر.</em>',
    sub: 'وصلتنا تفاصيلك وسنتواصل معك خلال 24 ساعة لتأكيد موعد مكالمتك الاستراتيجية. تابع بريدك الإلكتروني وواتساب.',
    nextTitle: 'ماذا يحدث بعد ذلك',
    next: [
      { t: 'نقرأ ما أرسلته', d: 'عملك ووضعك وأهدافك، لنأتي مستعدّين.' },
      { t: 'نتواصل معك خلال 24 ساعة', d: 'عبر البريد أو واتساب لتحديد موعد مكالمتك المجانية.' },
      { t: 'جلسة استراتيجية مجانية لمدة 30 دقيقة', d: 'نناقش عملك وما إذا كان منهجنا مناسباً لك. بلا ضغط.' },
    ],
    whileWait: 'أثناء الانتظار',
    audit: 'افحص موقعك مجاناً',
    home: 'العودة إلى الموقع',
    wa: 'راسلنا على واتساب',
  },
}[lang];
---

<Base lang={lang} title={t.title} description={t.sub} path="/thankyou" noindex hideFooterCta>
  <section class="ty" data-hero>
    <div class="container--narrow ty__inner">
      <span class="ty__check" aria-hidden="true"><Icon name="check" size={34} stroke={1.6} /></span>
      <p class="label">{t.kicker}</p>
      <h1 class="h1 ty__title" set:html={split(t.h)} />
      <p class="lead">{t.sub}</p>
      <ol class="ty__steps" role="list">
        {
          t.next.map((n, i) => (
            <li>
              <span class="ty__n tabular">0{i + 1}</span>
              <span>
                <strong>{n.t}</strong>
                <span class="small">{n.d}</span>
              </span>
            </li>
          ))
        }
      </ol>
      <p class="label label--line">{t.whileWait}</p>
      <div class="cluster">
        <Btn href={href(lang, '/tools/website-audit')} label={t.audit} variant="primary" icon="gauge" />
        <Btn href={SITE.whatsapp} label={t.wa} icon="whatsapp" target="_blank" rel="noopener" />
        <Btn href={href(lang, '/')} label={t.home} icon={false} />
      </div>
    </div>
  </section>
</Base>

<style>
  .ty {
    padding-top: calc(var(--nav-h) + clamp(48px, 8vw, 120px));
    padding-bottom: var(--section);
    background:
      radial-gradient(60% 50% at 50% 0%, rgb(255 255 255 / 0.08), transparent 65%),
      var(--bg);
  }
  .ty__inner {
    display: grid;
    gap: 24px;
  }
  .ty__check {
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: var(--fg);
    color: var(--bg);
    animation: pop 900ms var(--ease-back) both;
  }
  @keyframes pop {
    from {
      transform: scale(0.4);
      opacity: 0;
    }
  }
  .ty__title :global(.wi) {
    animation: ty-rise 1.2s var(--ease-out) both;
    animation-delay: calc(var(--i) * 50ms + 200ms);
  }
  .ty__title :global(em .wi) {
    background: linear-gradient(172deg, #fff 0%, #e4e4e4 30%, #8f8f8f 52%, #f5f5f5 70%, #b9b9b9 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  @keyframes ty-rise {
    from {
      transform: translate3d(0, 108%, 0);
    }
  }
  .ty__steps {
    display: grid;
    margin-block: 16px;
    border-top: 1px solid var(--line);
  }
  .ty__steps li {
    display: flex;
    gap: 20px;
    padding-block: 18px;
    border-bottom: 1px solid var(--line);
  }
  .ty__steps li > span:last-child {
    display: grid;
    gap: 2px;
  }
  .ty__n {
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
    width: 44px;
  }
  @media (max-width: 560px) {
    .ty .cluster :global(.btn) {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
